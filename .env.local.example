# Gemini API 키 — https://aistudio.google.com/app/apikey 에서 무료 발급
# 이 파일을 복사해서 .env.local 로 저장 후 키를 입력하세요
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gmail SMTP — 발송 전용 Gmail 계정 (구글 계정 설정 > 보안 > 2단계 인증 활성화 후 "앱 비밀번호" 발급)
# /generate, /n/[id] 페이지의 "무료 구독 신청" 폼이 서버(/api/subscribe)에서 haileycho@sk.com으로 이메일을 전달하는 데 사용
# scripts/migrations/send-subscriber-credentials.js의 구독자 로그인 정보 안내 메일 발송에도 동일 계정 사용
# (일반 로그인 비밀번호가 아닌 앱 비밀번호를 사용해야 함 — https://myaccount.google.com/apppasswords)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# AUTH_USERS — 더 이상 로그인 조회에 사용되지 않음 (계정 저장소는 Upstash Redis의 user:{email} 키로 이전됨)
# scripts/migrations/provision-subscriber-accounts.js가 최초 1회 이 값을 읽어 기존 편집자 계정을 Redis로 이전하는 용도로만 사용
# 마이그레이션 검증 후에는 삭제해도 무방
AUTH_USERS=[{"email":"your@email.com","passwordHash":"..."}]
